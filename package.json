{
  "name": "interview-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first Vietnamese interview copilot overlay with mocked Phase 1 pipeline.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run build && electron .",
    "smoke:electron": "cross-env ELECTRON_SMOKE=1 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "diagnostic:gemini": "npx tsx src/diagnostics/geminiDiagnostic.ts",
    "diagnostic:speculative": "npx tsx src/diagnostics/speculativeDiagnostic.ts",
    "diagnostic:turn-assembly": "npx tsx src/diagnostics/turnAssemblyDiagnostic.ts",
    "diagnostic:answer-contract": "npx tsx src/diagnostics/answerContractDiagnostic.ts",
    "diagnostic:interview-stress": "npx tsx src/diagnostics/interviewStressDiagnostic.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.node.json && vite build"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "lucide-react": "^0.468.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "vite": "^7.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}

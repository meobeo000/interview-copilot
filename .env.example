# Provider selection. Google Chirp 3 is the default when this is omitted.
STT_PROVIDER=google

# Google Cloud Speech-to-Text V2 / Chirp 3
GOOGLE_CLOUD_PROJECT_ID=
# Chirp 3 is GA in the us and eu multi-regions. Default: us.
GOOGLE_CLOUD_LOCATION=us
# Use ADC, gcloud user credentials, or a service-account file kept outside git.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
STT_GOOGLE_ADAPTATION=true

# Deepgram remains available for comparison/fallback by setting STT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# Renderer mock mode is for local UI tests only. It bypasses real STT entirely.
VITE_USE_MOCK_STT=false

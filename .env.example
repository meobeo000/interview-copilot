# Provider selection: deepgram | groq | openai | webspeech
STT_PROVIDER=deepgram

# Primary Streaming STT Key (Deepgram - Recommended for real-time WebSocket STT in Vietnamese)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Alternative STT Keys
GROQ_API_KEY=
OPENAI_API_KEY=

# Set to "true" to force mock transcript simulator for dev/testing only
VITE_USE_MOCK_STT=false
